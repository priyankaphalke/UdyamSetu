# UdyamSetu AI - Supabase Environment Configuration
# Copy this file to .env and insert your real project credentials from https://supabase.com/dashboard

# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Public API Key (found under Project Settings -> API)
VITE_SUPABASE_ANON_KEY=your-anon-key-here
